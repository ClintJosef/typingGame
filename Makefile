# Compiled game location
outputDir = output
programName = typingGame
result = $(outputDir)/$(programName)

# Wildcard expansion
sources = main.c $(wildcard lib/*.c) 
# Replace suffixes
objects = $(sources:.c=.o)
dependencies = $(objects:.o=.d)

# .txt files to be compiled into .h files used by textGen
wordDir = words
wordsList = $(wildcard $(wordDir)/*.txt)
# replace suffix and change name from words/* to output/words/*
wordHeaders = $(patsubst %.txt,$(outputDir)/%.h, $(wordsList))
wHeadersDir = $(outputDir)/$(wordDir)

BOLD = \033[1m
RESET = \033[0m

CC = cc
# Compiler flags
# -MMD and -MP generate .d (dependency) makefiles
CFLAGS = -Wall -MMD -MP
# Preprocessor flags
CPPFLAGS = -I$(outputDir)
# Linker flags
LDFLAGS =
# Libraries to link with
LDLIBS = -ltermcap

# In case i have files named after the targets
.PHONY: all clean compileWords compile
# Don't run with -j
.NOTPARALEL:

# Default target
all: $(result)

# Result requires all object files (and the output dir)
# If present, link them all into one final executable
$(result): compileWords compile | $(outputDir)
	@printf "$(BOLD)Linking with '$(CC) $(LDFLAGS) $(LDLIBS)'$(RESET)\n"
	@$(CC) $(LDFLAGS) $(objects) $(LDLIBS) -o $@
	@printf "$(BOLD)Linked .o files into $@$(RESET)\n"

# Purely intermediate targets so i can separate build stages with a newline
# Can still be run on their own tho (assuming they have what they need)
# Also, if statements to check what actually got built
compile: $(objects)
	@if [ -f $(outputDir)/.compiled ]; then \
		printf "$(BOLD)Compiled with '$(CC) -c $(CFLAGS) $(CPPFLAGS)'$(RESET)\n" ; \
		echo; \
		rm $(outputDir)/.compiled; \
	fi
compileWords: $(wordHeaders)
	@if [ -f $(outputDir)/.compiledWords ]; then \
		printf "$(BOLD)Compiled with 'xxd -i'$(RESET)\n" ; \
		echo; \
		rm $(outputDir)/.compiledWords; \
	fi

# Compile source files into the required object files
# $@ is the target (.o), $< is its first prerequisite (.c)
%.o: %.c
	@$(CC) -c $(CFLAGS) $(CPPFLAGS) $< -o $@
	@printf "$(BOLD)Compiled $<$(RESET)\n"
	@if [ ! -f $(outputDir)/.compiled ]; then \
		touch $(outputDir)/.compiled; \
	fi

# Compile .txt files to .h files for textGen
$(wHeadersDir)/%.h: $(wordDir)/%.txt | $(wHeadersDir)
	@xxd -i $< > $@
	@printf "$(BOLD)Compiled $< into $@$(RESET)\n"
	@if [ ! -f $(outputDir)/.compiledWords ]; then \
		touch $(outputDir)/.compiledWords; \
	fi
$(wHeadersDir):
	@mkdir -p $@
	@printf "$(BOLD)Created $@ directory$(RESET)\n"

# Create output dir if it doesnt exist
# Not really needed if wordHeaders target was run
$(outputDir):
	@printf "$(BOLD)Created output directory$(RESET)\n"

# Checks .d files generated by -MMD and -MP
# '-' just means 'dont complain that they dont exist yet'
-include $(dependencies)

# Cleanup (run with 'make clean')
clean:
	@rm -rf $(objects) $(dependencies) $(outputDir)
	@printf "$(BOLD)Deleted build files$(RESET)\n"
	@echo
